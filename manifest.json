{
  "manifest_version": 3,
  "name": "Advait",
  "version": "1.0.0",
  "description": "Offline UI extraction and AI-ready capture for any webpage.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Advait",
    "default_popup": "index.html"
  }
}
